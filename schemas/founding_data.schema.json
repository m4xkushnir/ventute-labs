{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "owner_name": {
      "title": "Owner Name",
      "type": "string"
    },
    "owner_background": {
      "title": "Owner Background",
      "type": "string"
    },
    "business_name": {
      "title": "Business Name",
      "type": "string"
    },
    "country": {
      "title": "Country",
      "type": "string"
    },
    "city": {
      "title": "City",
      "type": "string"
    },
    "starting_year": {
      "title": "Starting Year",
      "type": "integer"
    },
    "legal_structure": {
      "title": "Legal Structure",
      "type": "string"
    },
    "starting_capital": {
      "title": "Starting Capital",
      "type": "number"
    },
    "capital_source": {
      "title": "Capital Source",
      "type": "string"
    },
    "preferred_language": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Preferred Language"
    },
    "initial_physical_assets": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Initial Physical Assets"
    },
    "initial_tech": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Initial Tech"
    },
    "initial_inventory": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Initial Inventory"
    },
    "company_context": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Company Context"
    },
    "sector": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sector"
    },
    "operating_model": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Operating Model"
    }
  },
  "required": [
    "owner_name",
    "owner_background",
    "business_name",
    "country",
    "city",
    "starting_year",
    "legal_structure",
    "starting_capital",
    "capital_source"
  ],
  "title": "FoundingData",
  "type": "object",
  "description": "The company a run starts from: founder, business, location, capital and context."
}
